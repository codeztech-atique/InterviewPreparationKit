{
  // Note: GitHub Copilot auto-suggestions are controlled via VS Code settings
  // (e.g. .vscode/settings.json), not via launch configurations.
  "version": "0.2.0",
  "configurations": [
    

    {
      "type": "node",
      "request": "launch",
      "name": "Launch Current File",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
